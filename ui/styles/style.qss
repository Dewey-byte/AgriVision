/* AgriVision — responsive nature dashboard */

* {
    font-family: "Segoe UI", "Inter", system-ui, -apple-system, sans-serif;
    font-size: 13px;
    color: #1a2e1f;
}

QWidget#MainRoot {
    background-color: #e4ede3;
}

QFrame#headerBar {
    background-color: rgba(250, 252, 249, 0.98);
    border: none;
    border-bottom: 1px solid #d4e4d4;
    border-radius: 0;
}

QLabel#brandTitle {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: #1b4332;
}

QLabel#brandSubtitle {
    font-size: 11px;
    font-weight: 500;
    color: #52796f;
}

QFrame#statusChip {
    background-color: #f3f7f0;
    border: 1px solid #c8dcc9;
    border-radius: 16px;
}

QLabel#statusPill {
    font-size: 11px;
    font-weight: 600;
    color: #3d5a45;
    padding-right: 6px;
}

QLabel#statusDot,
QLabel#statusDotIdle {
    font-size: 10px;
    padding-left: 10px;
    padding-right: 2px;
    color: #9aad9e;
}

QLabel#statusDotOk {
    font-size: 10px;
    padding-left: 10px;
    padding-right: 2px;
    color: #40916c;
}

QSplitter#mainSplitter::handle {
    background-color: #c8dcc9;
    width: 4px;
    margin: 0;
    border-radius: 0;
}

QSplitter#mainSplitter::handle:hover {
    background-color: #52b788;
}

QFrame#primaryFeed {
    background-color: #fafcf9;
    border: none;
    border-right: 1px solid #d4e4d4;
    border-radius: 0;
}

QLabel#feedTitle {
    font-size: 13px;
    font-weight: 700;
    color: #1b4332;
    padding-left: 10px;
    border-left: 3px solid #52b788;
}

QFrame#videoViewport {
    background-color: transparent;
    border: none;
}

QLabel#fpsBadge {
    background-color: #1b4332;
    color: #d8f3dc;
    border-radius: 16px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#videoFeed {
    background-color: #0d1f14;
    border: none;
    border-radius: 0;
}

QLabel#lastUpdated {
    font-size: 11px;
    color: #6b7f70;
}

QPushButton#btnPrimary {
    background-color: #2d6a4f;
    color: #f8faf7;
    border: none;
    border-radius: 10px;
    padding: 10px 22px;
    font-weight: 600;
    min-width: 110px;
}

QPushButton#btnPrimary:hover {
    background-color: #40916c;
}

QPushButton#btnPrimary:pressed {
    background-color: #1b4332;
}

QPushButton#btnSecondary {
    background-color: #fafcf9;
    color: #2d6a4f;
    border: 1px solid #b7cbb8;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 600;
}

QPushButton#btnSecondary:hover {
    background-color: #eef4ec;
    border-color: #52b788;
}

QScrollArea#sidebarScroll {
    background: transparent;
    border: none;
}

QScrollArea#sidebarScroll > QWidget > QWidget {
    background: transparent;
}

QWidget#sidebarInner {
    background: transparent;
}

QWidget#sidebar {
    background-color: #f3f7f0;
}

QWidget#sourcePanel,
QWidget#dashboardCard {
    background-color: #fafcf9;
    border-radius: 10px;
    border: 1px solid #d4e4d4;
}

QLabel#cardTitle {
    font-size: 13px;
    font-weight: 700;
    color: #1b4332;
    padding-left: 10px;
    border-left: 3px solid #52b788;
}

QLabel#bodyLabel {
    font-size: 13px;
    color: #3d5a45;
}

QLabel#mutedLabel {
    font-size: 12px;
    color: #6b7f70;
}

QLabel#statValue {
    font-size: 24px;
    font-weight: 700;
    color: #1b4332;
}

QLabel#statValueSmall {
    font-size: 14px;
    font-weight: 700;
    color: #2d6a4f;
}

QLabel#healthWordGood {
    font-size: 14px;
    font-weight: 700;
    color: #40916c;
}

QLabel#healthWordFair {
    font-size: 14px;
    font-weight: 700;
    color: #bc6c25;
}

QLabel#healthWordPoor {
    font-size: 14px;
    font-weight: 700;
    color: #bc4749;
}

QLabel#healthWordMuted {
    font-size: 14px;
    font-weight: 600;
    color: #6b7f70;
}

QProgressBar#healthProgress {
    border: none;
    border-radius: 5px;
    background-color: #e4ede3;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar#healthProgress::chunk {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #40916c,
        stop: 1 #52b788
    );
    border-radius: 5px;
}

QLabel#miniPillHealthy {
    background-color: #d8f3dc;
    color: #1b4332;
    border-radius: 8px;
    padding: 5px 9px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#miniPillModerate {
    background-color: #faedcd;
    color: #7f5539;
    border-radius: 8px;
    padding: 5px 9px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#miniPillStress {
    background-color: #fde2e2;
    color: #9b2226;
    border-radius: 8px;
    padding: 5px 9px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#legendLabel {
    font-size: 11px;
    color: #52796f;
}

QWidget#leafletMapPanel {
    background-color: #eef4ec;
    border-radius: 10px;
    border: 1px solid #c8dcc9;
}

QLineEdit#geoLat, QLineEdit#geoLon {
    min-height: 28px;
    padding: 4px 8px;
    border: 1px solid #c8dcc9;
    border-radius: 8px;
    background: #fafcf9;
}

QTextEdit#activityLog {
    background-color: #f3f7f0;
    border: 1px solid #d4e4d4;
    border-radius: 10px;
    padding: 8px;
    font-size: 12px;
    color: #3d5a45;
    min-height: 72px;
    max-height: 120px;
}

QComboBox#mirrorOsCombo,
QComboBox#mirrorQualityCombo,
QLineEdit#androidIpEdit {
    border: 1px solid #c8dcc9;
    border-radius: 9px;
    padding: 8px 11px;
    background: #ffffff;
    min-height: 28px;
}

QComboBox#mirrorOsCombo:hover,
QComboBox#mirrorQualityCombo:hover,
QLineEdit#androidIpEdit:hover {
    border-color: #52b788;
}

QComboBox#mirrorOsCombo:focus,
QComboBox#mirrorQualityCombo:focus,
QLineEdit#androidIpEdit:focus {
    border-color: #40916c;
}

QComboBox#mirrorOsCombo::drop-down,
QComboBox#mirrorQualityCombo::drop-down {
    border: none;
    width: 22px;
}

QFrame#mirrorSeparator {
    border: none;
    background: #d8e6d8;
    max-height: 1px;
    margin: 4px 0;
}

QScrollBar:vertical {
    width: 7px;
    background: transparent;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #b7cbb8;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #52b788;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
