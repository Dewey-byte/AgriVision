/* AgriVision dashboard — light clinical mockup */

* {
    font-family: "Segoe UI", "Inter", system-ui, -apple-system, sans-serif;
    font-size: 13px;
    color: #212529;
}

QWidget#MainRoot {
    background-color: #f4f6f8;
}

QLabel#brandTitle {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: #111827;
}

QLabel#statusPill {
    font-size: 12px;
    color: #495057;
}

QLabel#statusDot {
    color: #28a745;
    font-size: 14px;
    padding-right: 4px;
}

QFrame#primaryFeed {
    background-color: #ffffff;
    border-radius: 14px;
    border: 1px solid #e9ecef;
}

QLabel#fpsBadge {
    background-color: #343a40;
    color: #f8f9fa;
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#videoFeed {
    background-color: #e8f5e9;
    border-radius: 12px;
    border: 1px solid #dee2e6;
}

QLabel#lastUpdated {
    font-size: 11px;
    color: #6c757d;
}

QPushButton#btnPrimary {
    background-color: #28a745;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 22px;
    font-weight: 600;
    min-width: 110px;
}

QPushButton#btnPrimary:hover {
    background-color: #218838;
}

QPushButton#btnPrimary:pressed {
    background-color: #1e7e34;
}

QPushButton#btnSecondary {
    background-color: #ffffff;
    color: #212529;
    border: 1px solid #ced4da;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
}

QPushButton#btnSecondary:hover {
    background-color: #f8f9fa;
}

QWidget#sidebar {
    background-color: transparent;
}

QWidget#dashboardCard {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e9ecef;
}

QLabel#cardTitle {
    font-size: 14px;
    font-weight: 700;
    color: #343a40;
}

QLabel#bodyLabel {
    font-size: 13px;
    color: #495057;
}

QLabel#mutedLabel {
    font-size: 12px;
    color: #6c757d;
}

QLabel#statValue {
    font-size: 22px;
    font-weight: 700;
    color: #212529;
}

QLabel#statValueSmall {
    font-size: 14px;
    font-weight: 600;
    color: #212529;
}

QLabel#healthWordGood {
    font-size: 14px;
    font-weight: 700;
    color: #28a745;
}

QLabel#healthWordFair {
    font-size: 14px;
    font-weight: 700;
    color: #ffc107;
}

QLabel#healthWordPoor {
    font-size: 14px;
    font-weight: 700;
    color: #dc3545;
}

QLabel#healthWordMuted {
    font-size: 14px;
    font-weight: 600;
    color: #6c757d;
}

QProgressBar#healthProgress {
    border: none;
    border-radius: 5px;
    background-color: #e9ecef;
}

QProgressBar#healthProgress::chunk {
    background-color: #28a745;
    border-radius: 5px;
}

QLabel#legendLabel {
    font-size: 11px;
    color: #495057;
}

QLabel#ndviPreview {
    background-color: #f8f9fa;
    border-radius: 10px;
    border: 1px solid #e9ecef;
}

QTextEdit#activityLog {
    background-color: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    padding: 8px;
    font-size: 12px;
    color: #495057;
}

QComboBox#castCombo {
    border: 1px solid #ced4da;
    border-radius: 8px;
    padding: 6px 10px;
    background: #ffffff;
    min-height: 28px;
}

QComboBox#castCombo:hover {
    border-color: #adb5bd;
}

QComboBox#castCombo::drop-down {
    border: none;
    width: 22px;
}

QLineEdit#castWindowTitle {
    border: 1px solid #ced4da;
    border-radius: 8px;
    padding: 8px 10px;
    background: #ffffff;
    min-height: 28px;
}

QLineEdit#castWindowTitle:focus {
    border-color: #28a745;
}

QPushButton#castPresetBtn {
    background-color: #f8f9fa;
    color: #212529;
    border: 1px solid #ced4da;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#castPresetBtn:hover {
    background-color: #e9ecef;
}

QCheckBox#castMaskCheck {
    font-size: 12px;
    color: #495057;
    spacing: 8px;
}

QScrollBar:vertical {
    width: 8px;
    background: #f1f3f5;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #ced4da;
    border-radius: 4px;
    min-height: 24px;
}
